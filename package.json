{
  "name": "agent-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "baseline": "node src/cli.ts baseline",
    "demo": "node src/cli.ts demo",
    "webhook": "node src/cli.ts webhook",
    "conversion": "node src/cli.ts conversion",
    "redirect": "node src/cli.ts redirect",
    "check:cli": "node scripts/check-cli.ts && node scripts/check-live.ts && node scripts/check-outcomes.ts && npm run build --silent && node scripts/check-library.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run check:cli",
    "eval": "node scripts/eval.ts",
    "build": "tsc -p tsconfig.library.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "mailparser": "3.14.5",
    "nodemailer": "10.6.0",
    "smtp-server": "3.21.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "exports": {
    "types": "./dist/guarded-apply.d.ts",
    "default": "./dist/guarded-apply.js"
  },
  "files": [
    "dist/guarded-apply.js",
    "dist/guarded-apply.d.ts"
  ]
}
